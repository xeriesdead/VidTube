run = "python3 main.py"
entrypoint = "main.py"
modules = ["python-3.12", "nodejs-24"]

[env]
PYTHONUNBUFFERED = "1"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8000
externalPort = 80

[agent]
expertMode = true

[deployment]
deploymentTarget = "cloudrun"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telegram Bot"

[[workflows.workflow]]
name = "Telegram Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[workflows.workflow.metadata]
outputType = "console"
